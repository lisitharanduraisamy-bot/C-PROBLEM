#include <stdio.h>

int main() {
    int num,rev=0,original=0;
    scanf("%d",&num);
    num=original;
    while(num>0){
        int digit=num%10;
        rev=rev*10+digit;
        num=num/10;
    }
    if(rev==original){
        printf("Palidrome");
    }else{
        printf("Not Palidrome");
    }

    return 0;
}

