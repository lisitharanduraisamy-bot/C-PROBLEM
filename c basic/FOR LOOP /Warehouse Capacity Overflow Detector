#include <stdio.h>

int main() {

    int capacity;
    int n;
    scanf("%d", &capacity);
    scanf("%d", &n);
    int arr[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int sum = 0;
    for (int i = 0; i < n; i++) {
        sum =sum+ arr[i];
    }
    int remaining;
    remaining = capacity-sum;
    printf("Remaining Capacity: %d\n",remaining);
    int count = 0;
    int add=0;
    for (int i = 0; i < n; i++) {
        add = add + arr[i];
        if (add>capacity) {
            count++;
        }
    }
    printf("Overflow Days: %d",count);

    return 0;
}
