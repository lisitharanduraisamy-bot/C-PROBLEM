#include <stdio.h>

int main() {

    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++) {
        scanf("%d",&arr[i]);
    }
    int count=0;
    for(int i=0;i<n;i++) {
        if(arr[i]<0) {
            count++;
        }
    }
    int min;
    min=arr[0];
    for(int i=0;i<n;i++) {
        if(arr[i]<min && arr[i]>0) {
            min=arr[i];
        }
    }
    if (count==n) {
        printf("No Positive");
    }else {
        printf("%d",min);
    }

    return 0;
}
