#include <stdio.h>

int main() {

    int row,column;
    scanf("%d %d",&row,&column);
    int arr[row][column];
    for (int i=0;i<row;i++) {
        for (int j=0;j<column;j++) {
            scanf("%d",&arr[i][j]);
        }
    }
    float minavg;
    int index=0;
    int sum=0;
    for (int i=0;i<column;i++) {
        sum=sum+arr[0][i];
    }
    minavg=(float)sum/column;
    for (int i=0;i<row;i++) {
        int add=0;
        for (int j=0;j<column;j++) {
            add=add+arr[i][j];
        }
        float avg=(float)add/column;
        if (avg<minavg) {
            minavg=avg;
            index=i;
        }
    }
    printf("%d",index);

    return 0;
}
