#include <stdio.h>

int main() {

    int row,column;
    scanf("%d %d",&row,&column);
    int arr[row][column];
    for (int i=0;i<row;i++) {
        for (int j=0;j<column;j++) {
            scanf("%d",&arr[i][j]);
        }
    }
    int max1=arr[0][0];
    int max2=arr[1][0];
    int min1=arr[0][0];
    int min2=arr[1][0];
    for (int i=0;i<column;i++) {
        if (arr[0][i]>max1) {
            max1=arr[0][i];
        }if (arr[0][i]<min1) {
            min1=arr[0][i];
        }
    }
    for (int i=0;i<column;i++) {
        if (arr[1][i]>max2) {
            max2=arr[1][i];
        }if (arr[1][i]<min2) {
            min2=arr[1][i];
        }
    }
    int product1=max1*max2;
    int product2=min1*min2;
    if (product1>product2) {
        printf("%d",product1);
    }else{
        printf("%d",product2);
    }
    return 0;
}
