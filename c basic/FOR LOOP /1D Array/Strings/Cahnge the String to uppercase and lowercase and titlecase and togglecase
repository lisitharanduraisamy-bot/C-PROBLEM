#include <stdio.h>
#include <string.h>
#include <ctype.h>

void uppercase(char *str) {
    for (int i=0; str[i]!='\0'; i++) {
        str[i] = toupper(str[i]);
    }
}
void lowercase(char *str) {
    for (int i=0; str[i]!='\0'; i++) {
        str[i] = tolower(str[i]);
    }
}
void title(char *str) {
    int new_word=1;
    for (int i=0; str[i]!='\0'; i++) {
        if (str[i]==' ') {
            new_word=1;
        }
        else if (new_word==1 && isalpha(str[i])) {
            str[i] = toupper(str[i]);
            new_word=0;
        }else {
            str[i]=tolower(str[i]);
        }
    }
}

void toggle(char *str) {
    for (int i=0; str[i]!='\0'; i++) {
        if (isupper(str[i])) {
            str[i] = tolower(str[i]);
        }else {
            str[i] = toupper(str[i]);
        }
    }
}




int main() {

    char str[500];
    fgets(str,sizeof(str), stdin);
    char copy1[500];
    strcpy(copy1,str);
    char copy2[500];
    strcpy(copy2,str);
    char copy3[500];
    strcpy(copy3,str);
    char copy4[500];
    strcpy(copy4,str);

    uppercase(copy1);
    lowercase(copy2);
    title(copy3);
    toggle(copy4);

    printf("Original String: %s\n",str);
    printf("Uppercase      : %s\n",copy1);
    printf("Lowercase      : %s\n",copy2);
    printf("Title          : %s\n",copy3);
    printf("Toggle         : %s\n",copy4);


    return 0;
}
