#include <stdio.h>

int main() {

  int n;
  scanf("%d", &n);
  int count=0;
  for (int i=2; i<n; i++) {
    int prime=0;
    for (int j=2; j<i; j++) {
      if (i%j==0) {
        prime=1;
        break;
      }
    }
    if (prime==0) {
      count++;
    }
  }
  printf("%d", count);

  return 0;
}



