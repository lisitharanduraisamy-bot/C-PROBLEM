#include <stdio.h>

int main() {

    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++) {
        scanf("%d",&arr[i]);
    }
    int max;
    max = arr[0];
    for(int i=0;i<n;i++) {
        if(arr[i]>max) {
            max = arr[i];
        }
    }
    printf("Max Heart Rate: %d\n",max);
    int count=0;
    for(int i=0;i<n;i++) {
        if(arr[i]>140) {
            count++;
        }
    }
    printf(" Danger Readings: %d",count);

    return 0;
}
