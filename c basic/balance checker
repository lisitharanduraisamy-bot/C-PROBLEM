#include <stdio.h>

int main() {
    int n;
    int count = 0;
    int sum = 0;
    int balance;
    int final_balance = 0;

    scanf("%d", &n);
    scanf("%d", &balance);

    int arr[n];

    for(int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    for(int i=0;i<n;i++) {
        sum=sum+arr[i];
    }
    final_balance=sum+balance;


    for(int i=0;i<n;i++) {
        balance = balance+arr[i];
        if(balance < 2000) {
            count++;
        }
    }

    printf("Final Balance: %d", final_balance);
    printf("\nLow Balance Days: %d", count);

    return 0;
}

