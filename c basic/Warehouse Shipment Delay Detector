#include <stdio.h>

int main() {
    int number;
    int count=0;
    int sum=0;
    scanf("%d", &number);
    int arr[number];
    for (int i = 0; i < number; i++) {
        scanf("%d", &arr[i]);
    }
    for (int i = 0; i < number; i++) {
        sum = sum + arr[i];
    }
    for (int i = 0; i < number; i++) {
        if (arr[i] > 2) {
            count++;
        }
    }
    printf("Total Delay: %d\n", sum);
    printf("Delayed Days: %d", count);


    return 0;
}

