#include <stdio.h>

int main() {
    int month;
    scanf("%d", &month);
    int year;
    if (month==1) {
        printf("January\n31 Days");
    }else if (month==2) {
        scanf("%d", &year);
        if (year%4==0 && year%100!=0 || year%400==0) {
            printf("February\nLeap Year - 29 Days");
        }else {
            printf("February\n28 Days");
        }
    }else if (month==3) {
            printf("March\n31 Days");
        }else if (month==4) {
            printf("April\n30 Days");
        }else if (month==5) {
            printf("May\n31 Days");
        }else if (month==6) {
            printf("June\n30 Days");
        }else if (month==7) {
            printf("July\n31 Days");
        }else if (month==8) {
            printf("August\n31 Days");
        }else if (month==9) {
            printf("September\n30 Days");
        }else if (month==10) {
            printf("October\n31 Days");
        }else if (month==11) {
            printf("November\n30 Days");
        }else if (month==12) {
            printf("December\n31 Days");
        }else {
            printf("Invalid month");
        }


    return 0;
}
