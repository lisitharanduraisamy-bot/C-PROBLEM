#include <stdio.h>

int main() {
    int max_weight;
    int num_of_passengers;
    int sum=0;
    int count=0;
    scanf("%d", &max_weight);
    scanf("%d", &num_of_passengers);
    int arr[num_of_passengers];
    for (int i = 0; i < num_of_passengers; i++) {
        scanf("%d", &arr[i]);
    }
    for (int i = 0; i < num_of_passengers; i++) {
        sum=sum+arr[i];
        if (sum<max_weight) {
            count++;
        }
    }
    printf("Passengers Allowed: %d\n", count);
    if (sum<max_weight) {
        printf("Overload: No");
    }else {
        printf("Overload: Yes");
    }

    return 0;
}

