#include <stdio.h>

int main() {
    int a,b;
    printf("Enter two Numbers: ");
    scanf("%d %d",&a,&b);
    printf("Enter your choice 1 for sum and 2 for difference: ");
    int choice;
    scanf("%d",&choice);
    switch(choice){
        case 1:printf("%d",a+b);
        break;
        case 2:printf("%d",a-b);
        break;
        default:printf("enter valid choice");
    }

    return 0;
}
