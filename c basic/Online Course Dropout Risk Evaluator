#include <stdio.h>

int main() {
    int number;
    int count=0;
    scanf("%d", &number);
    int arr[number];
    for (int i = 0; i < number; i++) {
        scanf("%d", &arr[i]);
    }
    for (int i = 0; i < number; i++) {
        if (arr[i] == 0) {
            count++;
        }
    }
    printf("Inactive Weeks: %d\n", count);
    int temp = 0;
    temp=number-count;
    if (count>=temp) {
        printf("Risk Status: High\n");
    }else {
        printf("Risk Status: Low");
    }

    return 0;
}

