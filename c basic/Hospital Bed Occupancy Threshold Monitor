#include <stdio.h>

int main() {
    int capacity;
    int hours;
    int sum=0;
    int count=0;
    scanf("%d", &capacity);
    scanf("%d", &hours);
    int arr[hours];
    for (int i = 0; i < hours; i++) {
        scanf("%d", &arr[i]);
    }
    for (int i = 0; i < hours; i++) {
        sum=sum+arr[i];
        if (sum>(capacity*90)/100) {
            count++;
        }
    }
    printf("Final Occupied beds: %d\n", sum);
    printf("Critical Hours: %d",count);

    return 0;
}

