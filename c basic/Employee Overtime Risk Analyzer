#include <stdio.h>

int main() {
    int hours;
    scanf("%d", &hours);
    int arr[hours];
    for (int i = 0; i < hours; i++) {
        scanf("%d", &arr[i]);
    }
    int sum = 0;
    int count = 0;
    for (int i = 0; i < hours; i++) {
        sum=sum+arr[i];
    }
    for (int i = 0; i < hours; i++) {
        if (arr[i]>4) {
            count++;
        }
    }
    printf("Total Overtime: %d\n", sum);
    printf("Burnout Days: %d", count);


    return 0;
}

