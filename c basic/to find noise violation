#include <stdio.h>

int main() {
    int n;
    int count=0;
    int arr[n];
    scanf("%d", &n);
    for (int i=1; i<=n; i++) {
        scanf("%d", &arr[i]);
    }
    for (int i=1; i<=n; i++) {
        if (arr[i]>70) {
            count++;
        }
    }
    printf("Noise Violations:%d", count);

    return 0;
}
