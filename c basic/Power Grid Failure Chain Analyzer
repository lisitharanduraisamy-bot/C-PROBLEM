#include <stdio.h>

int main() {
    int capacity;
    int n;
    scanf("%d", &capacity);
    scanf("%d", &n);
    int arr[n];
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int count = 0;
    for (int i = 0; i < n; i++) {
        if (arr[i] > capacity) {
            count++;
        }
    }
    int safe_hours;
    safe_hours = n - count;
    printf("Safe Hours: %d\n", safe_hours);
    printf("Failure Count: %d\n", count);


    return 0;
}

