#include <stdio.h>

int main() {

    int num,original;
    int digit;
    int sum=0;
    scanf("%d", &num);
    original=num;
    while(num!=0) {
        digit = num%10;
        int result=1;
        for (int i=1; i<=3; i++) {
            result=result*digit;
        }
        sum=sum+result;
        num=num/10;
    }
    if (sum==original) {
        printf("YES");
    }else {
        printf("NO");
    }

    return 0;
}
